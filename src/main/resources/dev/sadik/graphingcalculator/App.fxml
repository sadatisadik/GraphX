<AnchorPane prefHeight="681.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(from 0% 50% to 100% 50%, #3b8d99 0%, #6b6b83 50%, #aa4b6b 100%);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.sadik.graphingcalculator.AppController">
