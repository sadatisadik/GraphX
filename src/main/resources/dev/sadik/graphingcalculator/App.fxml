          <yAxis>
              <NumberAxis autoRanging="false" lowerBound="-10" side="LEFT" tickLabelFill="WHITE" tickUnit="1" upperBound="10" />
          </yAxis>
      </LineChart>
      <TextField fx:id="equationBox" layoutX="48.0" layoutY="52.0" prefHeight="38.0" prefWidth="411.0" promptText="i.e: sin^x+cos2x">
         <font>
            <Font size="17.0" />
         </font></TextField>
      <GridPane hgap="10.0" layoutX="48.0" layoutY="100.0" prefHeight="38.0" prefWidth="411.0" vgap="10.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
